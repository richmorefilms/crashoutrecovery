# Crashout Recovery — local env (do not commit real secrets)
# Copy to .env or set in your shell before `python main.py`

# Google Cloud → YouTube Data API v3 key (server-side only)
CRASHOUT_YOUTUBE_API_KEY=

# Environment: development|dev|test allow the default JWT secret; production must set a real secret.
# CRASHOUT_ENV=development

# Required outside development/test — use a long random string (32+ bytes).
# CRASHOUT_JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
# CRASHOUT_JWT_EXPIRE=1200
# CRASHOUT_JWT_REFRESH_EXPIRE=1209600

# Staff bootstrap is no longer email-based. Register a normal user, then:
#   python scripts/promote_staff.py --username <name>
# or POST /auth/staff/promote (requires an existing staff session).

# Phase G — Hostinger media origin (CDN/public base). Local fallback serves /media from data/media.
# HOSTINGER_MEDIA_BASE_URL=https://media.crashoutrecovery.app

# Google AdSense (web story pages)
# CRASHOUT_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# CRASHOUT_ADSENSE_SLOT_TOP=
# CRASHOUT_ADSENSE_SLOT_MID=
# CRASHOUT_ADSENSE_SLOT_FOOTER=

# Google AdMob (mobile apps via GET /ads/mobile-config)
# CRASHOUT_ADMOB_APP_ID=ca-app-pub-xxxxxxxx~yyyyyyyy
# CRASHOUT_ADMOB_AD_UNIT_ID=ca-app-pub-xxxxxxxx/zzzzzzzz
# CRASHOUT_ADMOB_BANNER_UNIT_ID=
# CRASHOUT_ADMOB_INTERSTITIAL_UNIT_ID=
